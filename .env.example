# Copy this file to ".env" and fill in your real values.

# Use the SAME Neon connection string as your registration site
# (bharat-expo), so this portal reads the exact same data.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/YOUR_DB?sslmode=require

# Any long random string — used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Admin login credentials for this portal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Port the local server runs on (optional, defaults to 4000)
PORT=4000

# -----------------------------------------------------------------
# EVENT BRANDING — this is the ONLY section you touch to reuse this
# same portal for a different event. Update these, put the new logo
# file in public/images/, point DATABASE_URL above at the new event's
# DB, and redeploy. No code changes needed.
# -----------------------------------------------------------------
EVENT_NAME=Bharat Packaging Expo
EVENT_TAGLINE=PACKAGING · SUSTAINABILITY · INNOVATION
EVENT_DATE_RANGE=30 Aug – 02 Sept 2027
EVENT_VENUE=India Expo Centre & Mart, Greater Noida

# Logo filename(s) — must already exist inside public/images/
EVENT_LOGO=bharat-packaging-expo-logo.png
EVENT_LOGO_2X=bharat-packaging-expo-logo@2x.png

EVENT_COPYRIGHT_YEAR=2026–27

# Set to true only for events that have an overseas buyers category
# (used later by the Buyers section — leave false for now)
HAS_OVERSEAS_BUYERS=false
